# slashkit — the linker used by the FINN Slash flow.
#
# supply only. AMD distributes this directly, not from a public URL.
#
#   cp slashkit.deb <finn>/docker/packages/slashkit.deb
#   FINN_RUNTIMES=xrt,slash,slashkit docker buildx bake -f docker-bake.hcl finn-runtime
#
# This used to be a bare package COPY in the build-xrt stage. That baked
# the package when the file happened to be present and silently did not when it
# was absent, and the tag was identical either way -- two materially different
# images under one name. Naming it here puts it in the tag.
SOURCE=supply
FILES=slashkit.deb
