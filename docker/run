#!/usr/bin/env bash
# Copyright (C) 2026, Advanced Micro Devices, Inc.
# SPDX-License-Identifier: BSD-3-Clause
set -euo pipefail
DOCKER_DIR=$(cd "$(dirname "$0")" && pwd)
REPO=$(dirname "$DOCKER_DIR")
# Select the checkout containing this launcher, even after native activation of another one.
export FINN_ROOT="$REPO"
. "$DOCKER_DIR/lib.sh"
TIER=dev
RUNTIMES=${FINN_RUNTIMES:-}
PRINT=0
OPTS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --fpga) TIER=build; shift ;;
        --runtime)
            [ "$#" -ge 2 ] || { echo '--runtime requires a name' >&2; exit 2; }
            RUNTIMES="${RUNTIMES:+$RUNTIMES,}$2"; shift 2 ;;
        --runtime=*) RUNTIMES="${RUNTIMES:+$RUNTIMES,}${1#*=}"; shift ;;
        --volume|--env|--workdir|--name|-n)
            [ "$#" -ge 2 ] || { echo "$1 requires a value" >&2; exit 2; }
            opt=$1; [ "$opt" != -n ] || opt=--name
            OPTS+=("$opt" "$2"); shift 2 ;;
        --notebook) OPTS+=(--notebook); shift ;;
        --rebuild) export FINN_CONTAINER_REBUILD=1; shift ;;
        --no-build) export FINN_CONTAINER_NO_BUILD=1; shift ;;
        --print) PRINT=1; shift ;;
        --help|-h)
            echo 'Usage: docker/run [--fpga] [--runtime NAME] [--no-build] [--rebuild]'
            echo '                  [--volume SPEC] [--env NAME[=VALUE]] [--workdir DIR]'
            echo '                  [--name NAME] [--notebook] [-- COMMAND...]'
            exit 0 ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) break ;;
    esac
done
if [ "${FINN_CONTAINER_REBUILD:-0}" = 1 ] && [ "${FINN_CONTAINER_NO_BUILD:-0}" = 1 ]; then
    echo '--rebuild and --no-build are mutually exclusive' >&2; exit 2
fi
export FINN_RUNTIMES=$(finn_normalize_runtimes "$RUNTIMES")
finn_set_provenance
cd "$REPO"
target=$(finn_bake_target "$FINN_RUNTIMES")
if [ "$PRINT" = 1 ]; then
    printf 'tier=%s\nruntimes=%s\nbake_target=%s\nimage_revision=%s\n' "$TIER" "$FINN_RUNTIMES" "$target" "$FINN_IMAGE_REVISION"
    printf 'workspace=%s\n' "$FINN_ROOT"
    printf 'command='; printf '%q ' "$@"; printf '\n'
    exit 0
fi
# Resolve host inputs before an expensive build, and reuse exactly that request.
FINN_HOST_REQUEST=$(python3 "$DOCKER_DIR/config.py" inspect --tier "$TIER" --workspace-policy mirror)
export FINN_HOST_REQUEST
finn_prepare_image "$target"
exec python3 "$DOCKER_DIR/launch.py" --tier "$TIER" --image "$FINN_IMAGE" "${OPTS[@]}" -- "$@"
