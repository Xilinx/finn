pipeline {
  agent none
  stages {
    stage('Run Brevitas tests') {
      agent {
        label 'finn-build'
      }
      environment {
        TEST_NAME = "brevitas_suite"
        FINN_HOST_BUILD_DIR = "${env.FINN_HOST_BUILD_DIR}/${env.TEST_NAME}"
      }
      steps {
        catchError(stageResult: 'FAILURE') {
          script {
            // Clear reports even if Docker/overlay preparation fails before pytest.
            sh 'rm -rf -- brevitas_suite.xml brevitas_suite.html brevitas-provenance coverage_brevitas_suite'
            cleanPreviousBuildFiles(env.FINN_HOST_BUILD_DIR)

            // The committed lock stays unchanged; the command selects an overlay.

            sh 'FINN_RUNTIMES=${FINN_RUNTIMES:-xrt} ./docker/run --env BREVITAS_COMMIT --env PYTHONPATH=ci -- bash ci/scripts/brevitas_candidate.sh --junitxml=brevitas_suite.xml --html=brevitas_suite.html --self-contained-html --cov --cov-report=html:coverage_brevitas_suite'
            archiveArtifacts artifacts: 'brevitas-provenance/*', allowEmptyArchive: false

            // Stash the test results file(s)
            stash name: env.TEST_NAME, includes: "${env.TEST_NAME}.xml,${env.TEST_NAME}.html"

            // Use an env variable to help collect test results later in pipeline
            env.BREVITAS = "SUCCESS"

            // Archive coverage report if successful
            archiveSuccessfulStage(env.BREVITAS, "coverage_${env.TEST_NAME}")
          }
        }
      }
      post {
        always {
          junit testResults: 'brevitas_suite.xml', allowEmptyResults: true
          archiveArtifacts artifacts: 'brevitas_suite.html,brevitas-provenance/*,coverage_brevitas_suite/**/*', allowEmptyArchive: true
        }
      }
    }
  }
}

void cleanPreviousBuildFiles(String buildDir) {
  // Delete any build files from a previous build
  // Previous build folders affect findCopyZip() and can cause the stage to fail
  if (!buildDir.empty) {
    if (env.USER_CREDENTIALS) {
      sh "echo $USER_CREDENTIALS_PSW | sudo -S rm -rf ${buildDir}*"
    } else {
      sh "rm -rf ${buildDir}"
    }
  }
}

void archiveSuccessfulStage(String stageEnvVariableSet, String folder) {
  if (stageEnvVariableSet) {
    archiveArtifacts artifacts: "${folder}/**/*"
  }
}
